# Copy to .env and fill in locally. NEVER commit .env or real credentials.
# The local notification backend works with none of these set.

# --- Amazon SNS alerting (optional) ---
SNS_TOPIC_ARN=arn:aws:sns:REGION:ACCOUNT_ID:agent-governance-alerts
AWS_REGION=us-east-1
# AWS credentials: prefer the standard chain (aws configure / IAM role / SSO).
# Only set these for local experiments WITH THROWAWAY, non-production keys:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# --- Optional CloudTrail reader ---
# CLOUDTRAIL_ENABLED=false
# CLOUDTRAIL_LOOKUP_EVENT_ATTRIBUTE=
