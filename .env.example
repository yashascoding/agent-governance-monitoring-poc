# Copy to .env and fill in locally. NEVER commit .env or real credentials.
# The local notification backend works with none of these set.

# --- Amazon SNS alerting (optional) ---
SNS_TOPIC_ARN=arn:aws:sns:REGION:ACCOUNT_ID:agent-governance-alerts
AWS_REGION=us-east-1
# AWS credentials: prefer the standard chain (aws configure / IAM role / SSO).
# Only set these for local experiments WITH THROWAWAY, non-production keys:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# --- Optional CloudTrail reader ---
# CLOUDTRAIL_ENABLED=false
# CLOUDTRAIL_LOOKUP_EVENT_ATTRIBUTE=

# --- Local governance web application ---
# Copy this file to .env, replace all placeholder values, and never commit .env.
POSTGRES_DB=governance
POSTGRES_USER=governance
POSTGRES_PASSWORD=replace-with-a-unique-local-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=55432
BACKEND_HOST_PORT=8001
FRONTEND_HOST_PORT=3000
# Optional full override; by default SQLAlchemy composes this URL from POSTGRES_*.
# DATABASE_URL=postgresql+psycopg://governance:password@db:5432/governance

# Generate independent keys with: openssl rand -hex 32
JWT_SECRET=replace-with-output-from-openssl-rand-hex-32-minimum-32-characters
JWT_EXPIRY_MINUTES=30
APPROVAL_SIGNING_SECRET=replace-with-a-different-openssl-rand-hex-32-value
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ANOMALY_THRESHOLD_SECONDS=60

# Local seeded accounts; change these passwords before first startup.
SEED_APPROVER_EMAIL=approver@example.com
SEED_APPROVER_PASSWORD=replace-with-a-unique-password-at-least-12-chars
SEED_VIEWER_EMAIL=viewer@example.com
SEED_VIEWER_PASSWORD=replace-with-a-different-password-at-least-12
